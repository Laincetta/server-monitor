[Unit]
Description=Server Monitor Dashboard
After=network.target

[Service]
Type=simple
User=monitor
WorkingDirectory=/opt/server-monitor
EnvironmentFile=/opt/server-monitor/.env
ExecStart=/opt/server-monitor/venv/bin/waitress-serve \
    --listen=0.0.0.0:5000 \
    --threads=4 \
    monitor:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
